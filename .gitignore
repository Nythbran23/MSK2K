# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSK2K Specific
# Ignore local configuration so you don't leak your callsign or audio devices
msk2k.cfg

# Ignore logs
**/*.log
**/*.adi

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Finder duplicate files
* 2.rs
* 2.toml

# FSK441 capture data (binary, large, kept outside repo)
*.db
*.db-shm
*.db-wal
*.wav
*.tar.xz
pings.txt
cty.dat

# Secrets — never commit credentials
*pat.txt
*token*.txt
